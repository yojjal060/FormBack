{
  "manifest_version": 3,
  "name": "FormBack — Private form drafts",
  "version": "0.2.0",
  "description": "Save and restore multi-step form drafts on your device.",
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_popup": "popup.html", "default_title": "FormBack" }
}
